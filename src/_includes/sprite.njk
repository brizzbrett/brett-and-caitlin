{#- The seven midsummer flowers, drawn as flat paper cut-outs with white linework, plus the bouquet mark.
    Use with <svg class="flower"><use href="#f-daisy"/></svg>. Every page of the site has one flower. -#}
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <path id="daisy-petal" d="M32 31 C28.5 25 28.6 13 32 5.5 C35.4 13 35.5 25 32 31 Z"/>
    <path id="cornflower-floret" d="M30.4 29 L27 13.5 L28.6 9.5 L30.4 12.6 L32 8 L33.6 12.6 L35.4 9.5 L37 13.5 L33.6 29 Z"/>
    <path id="cranesbill-petal" d="M32 32 C23.5 27 21 15 27 9.5 C29 8.5 30.6 10 32 12.8 C33.4 10 35 8.5 37 9.5 C43 15 40.5 27 32 32 Z"/>
    <path id="poppy-petal" d="M32 32 C21 31 12.5 22 17 13.5 C21 7 28.5 8.5 32 13 C35.5 8.5 43 7 47 13.5 C51.5 22 43 31 32 32 Z"/>
  </defs>

  <symbol id="f-daisy" viewBox="0 0 64 64">
    <g fill="#FFFDF7" stroke="#2F5D3A" stroke-width="1.4" stroke-linejoin="round">
      {%- for a in range(0, 360, 26) %}<use href="#daisy-petal" transform="rotate({{ a }} 32 32)"/>{% endfor %}
    </g>
    <circle cx="32" cy="32" r="8.5" fill="#F2C230"/>
    <g fill="#FFFDF7"><circle cx="29" cy="30" r="1.3"/><circle cx="34.5" cy="29.5" r="1.3"/><circle cx="32" cy="34.5" r="1.3"/><circle cx="36" cy="34" r="1"/><circle cx="28" cy="35" r="1"/></g>
  </symbol>

  <symbol id="f-cornflower" viewBox="0 0 64 64">
    <g fill="#3A57A6">
      {%- for a in range(0, 360, 40) %}<use href="#cornflower-floret" transform="rotate({{ a }} 32 32)"/>{% endfor %}
    </g>
    <g stroke="#FFFDF7" stroke-width="1.3" stroke-linecap="round">
      {%- for a in range(0, 360, 40) %}<line x1="32" y1="25" x2="32" y2="14" transform="rotate({{ a }} 32 32)"/>{% endfor %}
    </g>
    <circle cx="32" cy="32" r="6.5" fill="#26346B"/>
    <circle cx="32" cy="32" r="3" fill="none" stroke="#FFFDF7" stroke-width="1.2"/>
  </symbol>

  <symbol id="f-buttercup" viewBox="0 0 64 64">
    <g fill="#F2C230">
      {%- for a in range(0, 360, 72) %}<circle cx="32" cy="17.5" r="11.5" transform="rotate({{ a }} 32 32)"/>{% endfor %}
    </g>
    <g fill="none" stroke="#FFFDF7" stroke-width="1.6" stroke-linecap="round">
      {%- for a in range(0, 360, 72) %}<path d="M26.5 15.5 Q32 9.5 37.5 15.5" transform="rotate({{ a }} 32 32)"/>{% endfor %}
    </g>
    <circle cx="32" cy="32" r="6.5" fill="#C98A12"/>
    <g fill="#FFFDF7">{%- for a in range(0, 360, 45) %}<circle cx="32" cy="27.6" r="1.1" transform="rotate({{ a }} 32 32)"/>{% endfor %}</g>
  </symbol>

  <symbol id="f-clover" viewBox="0 0 64 64">
    <path d="M32 40 C32 48 31 54 28 60" fill="none" stroke="#2F5D3A" stroke-width="2.6" stroke-linecap="round"/>
    <g fill="#2F5D3A">
      <path d="M30 50 C22 44 14 47 15 53 C16 58 24 58 30 50 Z"/>
      <path d="M31 50 C35 41 44 40 46 46 C48 52 41 55 31 50 Z"/>
    </g>
    <g stroke="#FFFDF7" stroke-width="1.1" fill="none" stroke-linecap="round"><path d="M29 50.5 L19 52.5"/><path d="M32 49.5 L42 46.5"/></g>
    <g fill="#D9708F">
      {%- for a in range(0, 360, 30) %}<circle cx="32" cy="12" r="5.5" transform="rotate({{ a }} 32 23)"/>{% endfor %}
      <circle cx="32" cy="23" r="11"/>
    </g>
    <g fill="none" stroke="#FFFDF7" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M26 16 L28.5 19 L31 16"/><path d="M33 16 L35.5 19 L38 16"/>
      <path d="M23.5 23 L26 26 L28.5 23"/><path d="M29.5 23 L32 26 L34.5 23"/><path d="M35.5 23 L38 26 L40.5 23"/>
      <path d="M27 29.5 L29.5 32.5 L32 29.5"/><path d="M33 29.5 L35.5 32.5 L38 29.5"/>
    </g>
  </symbol>

  <symbol id="f-cranesbill" viewBox="0 0 64 64">
    <g fill="#7E52B0">
      {%- for a in range(0, 360, 72) %}<use href="#cranesbill-petal" transform="rotate({{ a }} 32 32)"/>{% endfor %}
    </g>
    <g fill="none" stroke="#FFFDF7" stroke-width="1.2" stroke-linecap="round">
      {%- for a in range(0, 360, 72) %}<g transform="rotate({{ a }} 32 32)"><path d="M32 28 L32 15"/><path d="M32 24 L28.5 18.5"/><path d="M32 24 L35.5 18.5"/></g>{% endfor %}
    </g>
    <circle cx="32" cy="32" r="4.5" fill="#FFFDF7"/>
    <circle cx="32" cy="32" r="2" fill="#4B2C75"/>
  </symbol>

  <symbol id="f-harebell" viewBox="0 0 64 64">
    <path d="M8 8 C24 3 38 6 40 21" fill="none" stroke="#2F5D3A" stroke-width="2.4" stroke-linecap="round"/>
    <path d="M20 6 C18 14 17 20 18 27" fill="none" stroke="#2F5D3A" stroke-width="2" stroke-linecap="round"/>
    <path d="M15 27 Q18 24 21 27 C21.5 31 22 33 24 36 L21 35 L18 38 L15 35 L12 36 C14 33 14.5 31 15 27 Z" fill="#5468C4"/>
    <path d="M34.5 23 Q40 18.5 45.5 23 C46.5 32 48 39 53 47 L47.5 45.5 L44 50 L40 45.5 L36 50 L32.5 45.5 L27 47 C32 39 33.5 32 34.5 23 Z" fill="#5468C4"/>
    <g fill="none" stroke="#FFFDF7" stroke-width="1.3" stroke-linecap="round">
      <path d="M37.5 26 C37.5 33 36.5 38 34 43"/><path d="M42.5 26 C42.5 33 43.5 38 46 43"/><path d="M40 25 L40 42"/>
      <path d="M17 29 C17 31 16.5 33 15.5 34"/>
    </g>
  </symbol>

  <symbol id="f-poppy" viewBox="0 0 64 64">
    <g fill="#D9411E" stroke="#FFFDF7" stroke-width="1.2" stroke-linejoin="round">
      {%- for a in [45, 135, 225, 315] %}<use href="#poppy-petal" transform="rotate({{ a }} 32 32)"/>{% endfor %}
    </g>
    <circle cx="32" cy="32" r="7.5" fill="#23302A"/>
    <g stroke="#FFFDF7" stroke-width="1.2" stroke-linecap="round">
      {%- for a in range(0, 360, 45) %}<line x1="32" y1="27" x2="32" y2="29.5" transform="rotate({{ a }} 32 32)"/>{% endfor %}
    </g>
    <circle cx="32" cy="32" r="2.2" fill="#FFFDF7"/>
  </symbol>

  {#- The bouquet mark: three flowers on stems gathered with a bow. -#}
  <symbol id="bouquet-mark" viewBox="0 0 64 64">
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="17" cy="22" r="7.5" stroke-width="3"/>
      <circle cx="47" cy="22" r="7.5" stroke-width="3"/>
      <circle cx="32" cy="12" r="7.5" stroke-width="3"/>
      <path d="M21 28.5 L32 45 M43 28.5 L32 45 M32 19.5 L32 45 M32 45 L27 61 M32 45 L32 62 M32 45 L37 61" stroke-width="2.6"/>
      <path d="M32 45 C26 39 19 42 22 47 C24 50.5 29 48 32 45 Z M32 45 C38 39 45 42 42 47 C40 50.5 35 48 32 45 Z" stroke-width="2.2"/>
    </g>
  </symbol>
</svg>
